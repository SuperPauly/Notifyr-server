# Placeholders only; no credentials required in environment variables.
NOTIFYR_HOST=notifyr.example.invalid
NOTIFYR_TRAEFIK_ENTRYPOINT=websecure
# Exact reverse-proxy IPs/CIDRs; never use '*'. Change for your existing proxy.
NOTIFYR_TRUSTED_PROXIES=127.0.0.1
# Comma-separated origins, without trailing slash. Empty disables browser CORS.
NOTIFYR_CORS_ORIGINS=https://client.example.invalid
# Explicit operator-approved push-service origins; no wildcard origins.
NOTIFYR_PUSH_ORIGINS=https://push.example.invalid
# Separate exception for a self-hosted origin resolving to private addresses.
NOTIFYR_PRIVATE_PUSH_ORIGINS=
NOTIFYR_VAPID_SUBJECT=mailto:admin@example.invalid
NOTIFYR_MAX_RECIPIENTS=100
NOTIFYR_MAX_REQUEST_BYTES=131072
